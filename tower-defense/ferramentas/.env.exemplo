# Copie este arquivo para .env (sem o .exemplo) e preencha o valor.
#
# O .env ja esta no .gitignore da raiz do repositorio -- confira com:
#     git check-ignore -v tower-defense/ferramentas/.env
#
# NUNCA cole a chave no chat. Ela fica gravada no historico da conversa e
# passa a exigir revogacao. Os dois caminhos seguros estao no README.md
# desta pasta.

OPENAI_API_KEY=coloque-a-chave-aqui

# Opcionais
OPENAI_IMAGE_MODEL=gpt-image-1
